# Supabase Configuration
# =====================
# Copy file ini ke .env dan isi dengan credentials dari Supabase dashboard
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
#
# .env - untuk development local (git ignored)
# .env.local - untuk production (git ignored, WAJIB untuk deploy)

# ============================================================================
# FRONTEND CONFIGURATION (Vite Environment Variables)
# ============================================================================
# Copy ke .env untuk development

# URL Project Supabase
# Format: https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anonymous/Public Key dari Supabase
# Ini adalah key yang aman untuk digunakan di frontend
# Jangan gunakan service_role key di frontend!
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Customer portal enabled/disabled
VITE_CLIENT_PORTAL_ENABLED=false

# ============================================================================
# DATABASE DEPLOYMENT (PostgreSQL Connection)
# ============================================================================
# Copy ke .env.local untuk deploy database (git ignored)

# Connection string untuk psql client
# Format: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# Untuk Supabase Direct Connection:
#   - Buka Supabase Dashboard > Settings > Database
#   - Copy URI dari "Connection string" > "URI"
#   - Atau gunakan "Connection parameters" untuk connection string
#
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ============================================================================
# SECURITY NOTES / CATATAN KEAMANAN
# ============================================================================
# 1. JANGAN pernah push .env atau .env.local ke GitHub!
# 2. .gitignore sudah dikonfigurasi untuk mengabaikan file ini
# 3. ANON_KEY aman untuk frontend karena RLS sudah aktif
# 4. SERVICE_ROLE_KEY hanya untuk server-side, JANGAN taruh di frontend!
# 5. DATABASE_URL adalah credential database - RAHASIAKAN!
# 6. Backup credential di tempat yang aman
# ============================================================================
