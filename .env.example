# Supabase Configuration
# =====================
# Copy file ini ke .env dan isi dengan credentials dari Supabase dashboard
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# URL Project Supabase
# Format: https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anonymous/Public Key dari Supabase
# Ini adalah key yang aman untuk digunakan di frontend
# Jangan gunakan service_role key di frontend!
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Limited public beta: keep the customer portal disabled.
VITE_CLIENT_PORTAL_ENABLED=false

# ============================================================================
# Catatan Penting:
# ============================================================================
# 1. Jika variable ini belum diset atau menggunakan placeholder,
#    aplikasi akan tetap berjalan menggunakan localStorage fallback.
#
# 2. ANON_KEY aman untuk frontend karena RLS (Row Level Security)
#    sudah dikonfigurasi di Supabase.
#
# 3. Jangan pernah taruh SERVICE_ROLE_KEY di file ini!
#
# 4. Setelah mengisi .env, restart development server.
# ============================================================================
